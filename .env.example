# API host (no trailing slash). Default: src/config/api.ts → API_BASE_URL
# /api/v1 is appended automatically by services/api.ts request()
EXPO_PUBLIC_API_URL=http://192.168.1.188:8000

# Razorpay public key (rzp_live_* or rzp_test_*). Never commit secret key.
EXPO_PUBLIC_RAZORPAY_KEY=

# Required. Expo's default fetch polyfill can't handle React Native's real
# multipart FormData part shape ({ uri, name, type }, no .file/.blob
# wrapper) - every image/audio upload in this app (profile photo, chat
# images, style-reference photos, order photos, voice notes) fails with
# "Unsupported FormDataPart implementation" without this. See
# .env.development's comment for the full root-cause explanation.
EXPO_PUBLIC_USE_RN_FETCH=1
